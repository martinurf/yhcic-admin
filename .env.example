# Copy to .env.local for development. In production these live only in
# the Vercel project's own Environment Variables settings — never here,
# never in a repo, never in a browser bundle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Officer inbox that gets a copy of every new membership application.
APPLICATION_NOTIFY_EMAIL=
